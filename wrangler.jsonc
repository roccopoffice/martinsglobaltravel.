{
  // Serves static assets on Cloudflare; proxies /.netlify/functions/* to Netlify backend.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "martinsglobaltravel",
  "main": "worker.js",
  "compatibility_date": "2026-07-21",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  }
}
